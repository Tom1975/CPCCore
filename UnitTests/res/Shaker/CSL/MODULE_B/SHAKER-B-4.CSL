;
; Fichier de script CSL 
; Execution du module SHAKE27B du DSK SHAKER27.DSK en CRTC 4
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 4
reset
wait 3000000
disk_insert 'shaker27.dsk'
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27B"\(RET)'
wait 10000000
;
; test 1 interlace c4/c9 counters R9 base=06
key_output '1'
wait_ssm 0x00E5
wait_ssm 0x00E7
key_output ' ' 
wait_ssm 0x00E9
key_output ' '
wait_ssm 0x00EB
key_output ' '
wait_ssm 0x00ED
key_output ' '
wait_ssm 0x00EF
key_output ' '
wait_ssm 0x00F1
key_output ' '
wait_ssm 0x00F3
key_output ' '
wait_ssm 0x00F5
key_output ' '
wait_ssm 0x00F7
key_output ' '
wait_ssm 0x00F9
key_output ' '
wait_ssm 0x03E8
key_output ' '
;
key_output 'X'	; Passe sur R9 BASE=7
wait 30000
;
key_output '1'
wait_ssm 0x00D0
wait_ssm 0x00D2
key_output ' ' 
wait_ssm 0x00D4
key_output ' ' 
wait_ssm 0x00D6
key_output ' ' 
wait_ssm 0x00D8
key_output ' ' 
wait_ssm 0x00DA
key_output ' ' 
wait_ssm 0x00DC
key_output ' ' 
wait_ssm 0x00DE
key_output ' ' 
wait_ssm 0x00E0
key_output ' ' 
wait_ssm 0x00E2
key_output ' ' 
wait_ssm 0x00E4
key_output ' ' 
wait_ssm 0x03E6
key_output ' ' 
;
; test 9 INTERLACE VM (garder la foi tu dois, mecreant, mouahahahaha)
key_output '9'		
wait_ssm 0x01C7
key_output ' '
wait_ssm 0x01C8
key_output ' '
;
key_output 'Y'		; Repasser en Even
key_output '9'		; En even
wait_ssm 0x01C9
key_output ' '
wait_ssm 0x01CA
key_output ' '
;
;
;; Test 0 (zero) vertical sub pixel scroll 
key_output '0' 
wait_ssm 0x00CB	; 1/8
key_output ' '
wait_ssm 0x00CC	; 1/16
key_output ' '
wait_ssm 0x00CD	; 1/32
key_output ' '
wait_ssm 0x00CE	; 1/64
key_output ' '
wait_ssm 0x00Cf	; 1/128
key_output ' '
;
;
;
; CRTC 2 FIND C0 MIN... (OPEN TEST)
key_output '4' ; 
wait_ssm 0x0192
wait_ssm 0x0193
key_output ' '
wait_ssm 0x0194
key_output ' '
wait_ssm 0x0195
key_output ' '
wait_ssm 0x0196
key_output ' '
wait_ssm 0x0197
key_output ' '
wait_ssm 0x0198
key_output ' '
wait_ssm 0x0199
key_output ' '
wait_ssm 0x019A
key_output ' '
;
;
; rlal crtc 2 (OPEN tous crtc)
key_output '5' 
wait_ssm 0x019B
key_output ' '
wait_ssm 0x019C
key_output ' '	; Menu
;
;
;
; R5 STORIES
key_output '\(RET)'
wait_ssm 0x01F6
wait_ssm 0x01F7
wait_ssm 0x01F8
wait_ssm 0x01F9
wait_ssm 0x01FA
wait_ssm 0x01FB
wait_ssm 0x01FC
wait_ssm 0x01FD
wait_ssm 0x0200
wait_ssm 0x0201
key_output ' '
wait_ssm 0x0202
wait_ssm 0x0203
wait_ssm 0x0204
wait_ssm 0x0205
wait_ssm 0x0206
wait_ssm 0x0207
wait_ssm 0x0208
wait_ssm 0x0209
wait_ssm 0x020A
wait_ssm 0x020B
key_output ' '
wait_ssm 0x020C
wait_ssm 0x020D
wait_ssm 0x020E
wait_ssm 0x020F
wait_ssm 0x0210
wait_ssm 0x0211
wait_ssm 0x0212
wait_ssm 0x0213
wait_ssm 0x0214
wait_ssm 0x0215
key_output ' '
;
;
; Test Bounga 
key_output '\(FN0)'
wait_ssm 0x01DD
key_output ' '
;
; Test RVNI LTD
;
key_output '\(CAP)'
wait_ssm 0x01D3
key_output ' '
;
;	
; Shaker Killer Don't be afraid. Mouhahahah
; Interrupt Delay From R2
;
key_output 'R'	
wait_ssm 0x01F0		;  2615301 z80aintb
key_output ' '
wait_ssm 0x01F1		; 4692484 r52Reset
key_output ' '
wait_ssm 0x01F2		; 7867387 Inter Test IM1
key_output ' '
wait_ssm 0x01F3		; 6888966 Inter Test IM2
key_output ' '
wait_ssm 0x01F4		; 1711766 R52 Incr
key_output ' '
wait_ssm 0x01F5		; 486262 Otir Zone
key_output ' '
;
;
; R3 JIT (interactif si necessaire)
key_output 'I'	
wait_ssm 0x01DE
key_output ' '	
wait_ssm 0x01DF
key_output ' '	
wait_ssm 0x01E0
key_output ' '	
wait_ssm 0x01E1
key_output ' '	
wait_ssm 0x01E2
key_output ' '	
wait_ssm 0x01E3
key_output ' '	
wait_ssm 0x01E4
key_output ' '	
wait_ssm 0x01E5
key_output ' '
;
;
; test crtc 1 , ouvert aux autres CRTCs
; BUG OUTI sur R0
;
key_output '6'
wait_ssm 0x019D
key_output ' '	
;
;
; Test Analyzer des premieres heures
; FORCED STAB CRTC 0 R0=0
;
key_output 'P'
wait_ssm 0x01E8
wait_ssm 0x01E9
key_output ' '
wait_ssm 0x01EA
wait_ssm 0x01EB
key_output ' '
wait_ssm 0x01EC
wait_ssm 0x01ED
key_output ' '
wait_ssm 0x01EE
wait_ssm 0x01EF
key_output ' '
;
csl_load 'SHAKER-B-3'