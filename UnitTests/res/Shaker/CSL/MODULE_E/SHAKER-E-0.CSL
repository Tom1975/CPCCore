;
; Fichier de script CSL 
; Execution du module SHAKE27E du DSK SHAKER27.DSK en CRTC 0
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 0
reset
wait 3000000
disk_insert 'shaker27.dsk'
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27E"\(RET)'
wait 10000000
;
; R5 STORIES 2ND ROUND 
key_output '1'
wait_ssm 0x03FA
key_output ' ' 
wait_ssm 0x03FB
key_output ' ' 
wait_ssm 0x03FC
key_output ' ' 
wait_ssm 0x03FD
key_output ' ' 
;
;
; CRTC 0 : C4/C9 COUNTER LOGIC
key_output '3'
wait_ssm 0x0403
key_output ' ' 
wait_ssm 0x0404		; Youhou!!
key_output ' ' 
wait_ssm 0x0405
key_output ' ' 

; CRTC 0 : C9 COMPARATOR R9/R5 SWITCH MECH
key_output '6'
wait_ssm 0x0407
key_output ' ' 
wait_ssm 0x0408
key_output ' ' 
wait_ssm 0x0409
key_output ' ' 
wait_ssm 0x040A
key_output ' ' 

;
csl_load 'SHAKER-E-1'