;
; Fichier de script CSL 
; Execution du module SHAKE27E du DSK SHAKER27.DSK en CRTC 0
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 0
reset
wait 3000000
disk_insert 'shaker27.dsk'
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27E"\(RET)'
wait 10000000
;
; R5 STORIES 2ND ROUND 
key_output '1'
wait 3000000		; 3fa
key_output ' ' 
wait_ssm0000
wait 5000000		; 3fb
key_output ' ' 
wait_ssm0000
wait 5000000		; 3fc
key_output ' ' 
wait_ssm0000
wait 8000000		; 3fd
key_output ' ' 
wait_ssm0000

wait 100000

;
;
; CRTC 0 : C4/C9 COUNTER LOGIC
key_output '3'
wait 6000000		; 403
key_output ' ' 
wait_ssm0000
wait 3000000		; 404
key_output ' '
wait_ssm0000
wait 3000000		; 405
key_output ' '
wait_ssm0000

wait 100000

; CRTC 0 : C9 COMPARATOR R9/R5 SWITCH MECH
key_output '6'
wait 6000000		; 407
key_output ' ' 
wait_ssm0000
wait 3000000		; 408
key_output ' '
wait_ssm0000
wait 3000000		; 409
key_output ' '
wait_ssm0000
wait 4000000       ; 40A

wait 100000


;

csl_load 'SHAKER-E-1.CSL'