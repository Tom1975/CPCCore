;
; Fichier de script CSL 
; Execution du module SHAKE27E du DSK SHAKER27.DSK en CRTC 1
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 1
reset
wait 3000000
disk_insert 'shaker27.dsk'
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27E"\(RET)'
wait 10000000
;
; R5 STORIES 2ND ROUND 
key_output '1'
wait_ssm 0x03FA
key_output ' ' 
wait_ssm 0x03FB
key_output ' ' 
wait_ssm 0x03FC
key_output ' ' 
wait_ssm 0x03FD
key_output ' ' 
;
;
; CRTC 1 : VMA TRT C4=R4=0 ON ADJ LINE
;
key_output '2'
wait_ssm 0x0400
key_output ' '
wait_ssm 0x0401
key_output ' '
wait_ssm 0x0402
key_output ' '
;
;
csl_load 'SHAKER-E-2'