;
; Fichier de script CSL 
; Execution du module SHAKE27A du DSK SHAKER27.DSK en CRTC 2
; Le module genere des instructions au format SSM
;
csl_version 1.0
crtc_select 2
reset
wait 3000000 
disk_insert 'shaker27.dsk'
key_delay 70000 70000 400000
key_output 'RUN"SHAKE27A"\(RET)'
wait 10000000
;
;
; test 1		; Update VRAM Versus CRTC (79 tests)
key_output '1'	
wait_ssm 0x0001		
key_output ' ' 
wait_ssm 0x0002		
key_output ' '
wait_ssm 0x0003		
key_output ' '
wait_ssm 0x0004		
key_output ' '
wait_ssm 0x0005		
key_output ' '
;
; test 2		; Skew Disp On R0 rupture (4 test)
key_output '2'
wait_ssm 0x0009
key_output ' '
wait_ssm 0x000A
key_output ' '
;
;
; test 3	; CRTC 2 RVMB (22 TST) comp autres CRTC
key_output '3'
wait_ssm 0x000B		; 2 ecrans
wait_ssm 0x000C		
key_output ' '
wait_ssm 0x000D		
wait_ssm 0x000E		
key_output ' ' 
wait_ssm 0x000F		
wait_ssm 0x0010		
key_output ' ' 
wait_ssm 0x0011
wait_ssm 0x0012
key_output ' ' 
wait_ssm 0x0013
wait_ssm 0x0014
key_output ' ' 
wait_ssm 0x0015
wait_ssm 0x0016
key_output ' ' 
wait_ssm 0x0017
wait_ssm 0x0018
key_output ' ' 
wait_ssm 0x0019
wait_ssm 0x001A
key_output ' ' 
wait_ssm 0x001B
wait_ssm 0x001C
key_output ' ' 
wait_ssm 0x001D
wait_ssm 0x001E
key_output ' ' 
wait_ssm 0x001F
wait_ssm 0x0020
key_output ' ' 
wait_ssm 0x0021
wait_ssm 0x0022
key_output ' ' 
wait_ssm 0x0023
wait_ssm 0x0024
key_output ' ' 
wait_ssm 0x0025
wait_ssm 0x0026
key_output ' ' 
wait_ssm 0x0027
wait_ssm 0x0028
key_output ' ' 
wait_ssm 0x0029
wait_ssm 0x002A
key_output ' ' 
wait_ssm 0x002B
wait_ssm 0x002C
key_output ' ' 
wait_ssm 0x002D
wait_ssm 0x002E
key_output ' ' 
wait_ssm 0x002F
wait_ssm 0x0030
key_output ' ' 
wait_ssm 0x0031
wait_ssm 0x0032
key_output ' ' 
wait_ssm 0x0033
wait_ssm 0x0034
key_output ' ' 
wait_ssm 0x0035
wait_ssm 0x0036
key_output ' ' 
;
; test 4 : Update CRTC R0 TIMING (17 tst)
key_output '4' 
wait_ssm 0x0037
key_output ' ' 
; 
; Gate Array Pixellisation
key_output '8'
wait_ssm 0x0086
key_output ' '
;
; Gate Array Inkerisation
key_output '9'
wait_ssm 0x0087
key_output ' '
wait_ssm 0x0088
key_output ' '
wait_ssm 0x0089
key_output ' '
;
; Gate Array Moderisation
key_output 'E'
wait_ssm 0x008C
key_output ' ' 
;
; Gfx Mode update according Hsync Delay (2.1.0) 
key_output 'R'
wait_ssm 0x00AF
wait_ssm 0x00B4
key_output ' ' 
wait_ssm 0x00B5
wait_ssm 0x00B6
key_output ' ' 
wait_ssm 0x00B7
wait_ssm 0x00BC
key_output ' '
;
;
; R2 update during and after Hsync (6 tst)
key_output 'T'
wait_ssm 0x00BD
key_output ' '
wait_ssm 0x00BE
key_output ' '
wait_ssm 0x00BF
key_output ' '
wait_ssm 0x00C0
key_output ' '
wait_ssm 0x00C1
key_output ' '
wait_ssm 0x00C2
key_output ' '
;
; R3 Update during Hsync (8 tst)
key_output 'Y'
wait_ssm 0x00C4
key_output ' '
wait_ssm 0x00C5
key_output ' '
wait_ssm 0x00C6
key_output ' '
wait_ssm 0x00C7
key_output ' '
wait_ssm 0x00C8
key_output ' '
wait_ssm 0x00C9
key_output ' '
wait_ssm 0x00CA
key_output ' '
wait_ssm 0x03AC
key_output ' '
;
;
; R4 & R9 Checkings
key_output 'U'
wait_ssm 0x00C3
key_output ' '
;
; Vsync Conditions (413 test) 
key_output 'I'
wait_ssm 0x008D
key_output ' '
wait_ssm 0x008E
key_output ' '
wait_ssm 0x008F
key_output ' '
wait_ssm 0x0090
key_output ' '
wait_ssm 0x0091		; Lost and Dead Vsync
key_output ' '
;
;
; R1 stories (8 tst)
key_output 'O'
wait_ssm 0x0092
key_output ' '
wait_ssm 0x0093
key_output ' '
wait_ssm 0x0094
key_output ' '
wait_ssm 0x0095
key_output ' '
wait_ssm 0x0096
key_output ' '
wait_ssm 0x0097
key_output ' '
wait_ssm 0x0098
key_output ' '
wait_ssm 0x0099
key_output ' '
wait_ssm 0x009A
key_output ' '
;
;
; R6 Stories (13 tst)
key_output 'P'
wait_ssm 0x009B
wait_ssm 0x009C
wait_ssm 0x009D
key_output ' '
wait_ssm 0x009E
key_output ' '
wait_ssm 0x009F
key_output ' '
wait_ssm 0x00A4
key_output ' '
wait_ssm 0x00A5
key_output ' '
wait_ssm 0x00A6
key_output ' '
wait_ssm 0x00A7
key_output ' '
wait_ssm 0x00AC
key_output ' '
wait_ssm 0x00AD
key_output ' '
wait_ssm 0x00AE
key_output ' '
;
; crtc 2 offset (r1)
;
key_output '\(COP)'
wait_ssm 0x008A
wait_ssm 0x008B
;
;
csl_load 'SHAKER-A-4'
